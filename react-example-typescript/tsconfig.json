{
  "compilerOptions": {
    "target": "es5",                           // 컴파일된 JavaScript가 대상으로 할 ECMAScript 버전 (여기서는 ES5).
    "lib": ["dom", "dom.iterable", "esnext"],  // 컴파일러에 포함될 라이브러리 타입 정의 목록.
    "allowJs": true,                           // JavaScript 파일(.js)의 컴파일을 허용.
    "skipLibCheck": true,                      // 선언 파일(.d.ts)의 타입 체크를 생략.
    "esModuleInterop": true,                   // ES6 모듈 사양에 맞게 CommonJS 모듈 가져오기를 허용.
    "allowSyntheticDefaultImports": true,      // default export가 없는 모듈을 default import하는 것을 허용.
    "strict": true,                            // 모든 엄격한 타입 체킹 옵션을 활성화.
    "forceConsistentCasingInFileNames": true,  // 파일 이름의 대소문자 일관성 강제.
    "module": "esnext",                        // 사용할 모듈 시스템 지정 (여기서는 최신).
    "moduleResolution": "node",                // 모듈 해석 방식을 Node.js 스타일로 지정.
    "resolveJsonModule": true,                 // JSON 파일을 import 할 수 있게 함.
    "isolatedModules": true,                   // 모든 파일이 별도의 모듈로 간주되도록 설정.
    "noEmit": true,                            // 출력 파일 생성 안 함 (타입 체크만 수행).
    "jsx": "react-jsx"                         // JSX 코드를 어떻게 처리할지 지정 (React 17 이상에 적합한 모드).
  },
  "include": ["src"]                          // 컴파일에 포함될 파일들의 디렉토리 지정.
}
